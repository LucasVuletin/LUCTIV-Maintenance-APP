    "@angular/forms": "20.3.27",
    "@angular/platform-browser": "20.3.27",
    "@angular/router": "20.3.27",
    "exceljs": "^4.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "20.1.6",
    "@angular/cli": "20.1.6",
    "@angular/compiler-cli": "20.3.27",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
