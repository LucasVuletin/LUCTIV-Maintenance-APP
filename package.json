{
  "name": "luctiv-maintenance-app",
  "version": "0.1.0",
  "description": "LUCTIV Maintenance APP — Operaciones y mantenimiento de bombas.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "sync:prime": "node scripts/sync-prime.mjs",
    "export:prime-sample": "node scripts/export-prime-sample.mjs",
    "verify:prime": "node scripts/verify-prime-acceptance.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
